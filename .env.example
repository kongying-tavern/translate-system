# Docker Compose 环境变量

# === OpenAPI 文档（默认 false，设 true 开启） ===
# OPENAPI_SWAGGER=Swagger UI 页面；OPENAPI_API_JSON=swagger.json（JWT 全量）
OPENAPI_SWAGGER=false
OPENAPI_API_JSON=false

# === 镜像（可选，国内环境使用） ===
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# === 项目 ===
COMPOSE_PROJECT_NAME=translate-system
VITE_APP_NAME=翻译管理平台

# === 数据目录 ===
DATA_ROOT=./data

# === PostgreSQL ===
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=translate_system
POSTGRES_PORT=20432

# === Backend ===
BACKEND_PORT=20080
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Node 堆内存上限（MB），仅数值拼接进 --max-old-space-size，不直接透传 NODE_OPTIONS
NODE_MEMORY_MB=4096

# === Frontend ===
FRONTEND_PORT=20010
